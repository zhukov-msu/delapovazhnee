# systemd-юнит для приложения. Скопировать в /etc/systemd/system/delapovazhnee.service
# и подставить USER и пути (см. deploy/DEPLOY.md). Затем: systemctl daemon-reload && systemctl enable --now delapovazhnee
[Unit]
Description=delapovazhnee — beach runner + presave A/B
After=network.target

[Service]
Type=simple
User=REPLACE_WITH_DEPLOY_USER
WorkingDirectory=/opt/delapovazhnee
EnvironmentFile=/opt/delapovazhnee/.env
ExecStart=/opt/delapovazhnee/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
