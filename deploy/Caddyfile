# Пока без домена — отдаём по HTTP на :80 (по IP сервера).
# Когда появится домен: замени блок `:80` на домен — Caddy сам выпустит и продлит TLS
# (нужны открытый порт 443 и A-запись домена на IP VDS). Пример:
#
#   delapovazhnee.ru {
#       reverse_proxy app:8000
#   }
#
:80 {
    reverse_proxy app:8000
}
